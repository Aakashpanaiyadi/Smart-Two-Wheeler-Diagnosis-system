void setup() {
  Serial.begin(9600);
}

void loop() {
  // Read analog values from potentiometer
  int Im = analogRead(A0); 
  int Vm = analogRead(A1); 
  int Tm = analogRead(A2); 
  int Ib = analogRead(A3); 
  int Vb = analogRead(A4); 
  int Tb = analogRead(A5); 

  // Map to ev parameters
  float Im_mapped = Im / 1023.0 * (80.0 - 60.0) + 60.0;  //60–80 A
  float Vm_mapped = Vm / 1023.0 * (60.0 - 48.0) + 48.0; // 48–60 V
  float Tm_mapped = Tm / 1023.0 * (55.0 - 45.0) + 45.0; // 45–55 °C
  float Ib_mapped = Ib / 1023.0 * (60.0 - 40.0) + 40.0; // 60–40 A
  float Vb_mapped = Vb / 1023.0 * (60.0 - 48.0) + 48.0; // 48–60 V
  float Tb_mapped = Tb / 1023.0 * (55.0 - 45.0) + 45.0; // 45–55 °C

  // Create a comma-separated string (1 decimal place)
  String data = String(Im_mapped, 1) + "," + String(Vm_mapped, 1) + "," + String(Tm_mapped, 1) + "," +
                String(Ib_mapped, 1) + "," + String(Vb_mapped, 1) + "," + String(Tb_mapped, 1);

  // Send with start and end markers
  Serial.print("<");
  Serial.print(data);
  Serial.println(">");

  delay(1000); // 1 second delay
}
